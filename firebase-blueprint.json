{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "User": {
      "title": "User",
      "description": "System user account including faculty, staff, and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "designation": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "employeeCode": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "An application for leave submitted by a faculty or staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicantId": { "type": "string" },
        "applicantName": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "appliedOn": { "type": "string" }
      },
      "required": ["id", "applicantId", "leaveType", "startDate", "endDate", "status"]
    },
    "Department": {
      "title": "Department",
      "description": "An academic or administrative department in the institution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "hodName": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "LeavePolicy": {
      "title": "LeavePolicy",
      "description": "Policy definition and annual quota for a leave type",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string" },
        "annualQuota": { "type": "number" }
      },
      "required": ["type", "label"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for leave workflow events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail log entry for administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorId", "action"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of all institutional faculty and staff accounts"
    },
    "leaveRequests": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Collection of leave applications"
    },
    "departments": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Collection of academic departments"
    },
    "leavePolicies": {
      "schema": { "$ref": "#/entities/LeavePolicy" },
      "description": "Collection of leave policies and quotas"
    },
    "notifications": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Collection of user notifications"
    },
    "auditLogs": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Collection of system audit logs"
    }
  }
}
