{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/status",
      "destination": "/api"
    },
    {
      "source": "/data",
      "destination": "/api"
    },
    {
      "source": "/diagnostics",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
