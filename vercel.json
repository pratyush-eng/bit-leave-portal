{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/status",
      "destination": "/api/index.ts"
    },
    {
      "source": "/data",
      "destination": "/api/index.ts"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
